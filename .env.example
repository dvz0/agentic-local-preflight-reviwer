# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
# Fallback if you have more VRAM: qwen2.5-coder:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

# LanceDB
LANCEDB_PATH=./data/lancedb
LANCEDB_TABLE=code_chunks

# App
DEFAULT_REPO_PATH=
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
RAG_TOP_K=4
OLLAMA_NUM_CTX=16384
MAX_DIFF_CHARS=6000
MAX_RAG_CHARS=8000
MAX_CONSOLIDATOR_CHARS=12000

# Optional Langfuse. See docs/dev.md.
# LANGFUSE_ENABLED sets the Streamlit checkbox default; the UI toggle
# controls tracing per audit. Keys are required for the toggle to work.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development
